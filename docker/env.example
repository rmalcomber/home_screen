# Copy to docker/.env and edit. Used by compose.caddy.yml.

# The address Caddy serves. "localhost" uses a local certificate (your browser will warn once).
# For a real name that points at this machine, Caddy gets a Let's Encrypt certificate by itself:
#   SITE_ADDRESS=home.example.com
SITE_ADDRESS=localhost

# The same name without a port: lets the curl runner work through the proxy.
SITE_HOSTNAME=localhost

BASIC_AUTH_USER=admin

# bcrypt hash from: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_HASH='$2a$14$replace-this-with-the-output-of-caddy-hash-password'

# Optional: pin the Home Screen image version (default: latest)
#HOME_SCREEN_TAG=0.1.0-beta
